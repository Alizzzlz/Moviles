<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- CORRECCIÓN DEL ERROR DE CÁMARA:
         CameraHelper guarda las fotos en context.filesDir/fotos/.
         Antes esa carpeta NO estaba declarada aquí, por lo que FileProvider lanzaba
         IllegalArgumentException ("Failed to find configured root") y la app mostraba
         "No se pudo abrir la cámara". -->
    <files-path name="fotos" path="fotos/" />

    <external-files-path name="my_images" path="Pictures/" />
    <cache-path name="my_cache_images" path="images/" />
</paths>




<!--xml sirve para configurar los permisos de acceso seguro a los archivos locales de tu
aplicación cuando necesitas compartirlos con otras aplicaciones del sistema
(como la app de la cámara o la Galería-->